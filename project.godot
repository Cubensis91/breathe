; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are meant to be edited using the UI.
;
; This file was created manually as part of Milestone 2 (pipeline
; validation), not exported from the Godot Editor. It is intentionally
; minimal — just enough to prove the project opens and runs headlessly.
; The Editor will happily rewrite/extend this file later; that's expected.

config_version=5

[application]

config/name="BREATHE"
config/description="Breathe. Rise. Survive."
run/main_scene="res://scripts/core/bootstrap.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/handheld/orientation="portrait"

[rendering]

renderer/rendering_method="mobile"
